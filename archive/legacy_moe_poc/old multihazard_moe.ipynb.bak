      "\u001b[36mCell\u001b[39m\u001b[36m \u001b[39m\u001b[32mIn[11]\u001b[39m\u001b[32m, line 62\u001b[39m\n\u001b[32m     58\u001b[39m             \u001b[38;5;28;01mreturn\u001b[39;00m out, feat\n\u001b[32m     59\u001b[39m         \u001b[38;5;28;01mreturn\u001b[39;00m out\n\u001b[32m     60\u001b[39m \n\u001b[32m     61\u001b[39m \u001b[38;5;66;03m# Prepare Radar Dataset with 80/20 Train/Validation Split\u001b[39;00m\n\u001b[32m---> \u001b[39m\u001b[32m62\u001b[39m norm_radar = (radar_scenes.astype(np.float32) / \u001b[32m255.0\u001b[39m).transpose(\u001b[32m0\u001b[39m, \u001b[32m3\u001b[39m, \u001b[32m1\u001b[39m, \u001b[32m2\u001b[39m)\n\u001b[32m     63\u001b[39m split_rd = int(\u001b[32m0.8\u001b[39m * len(norm_radar))\n\u001b[32m     64\u001b[39m x_tr_rd, y_tr_rd = norm_radar[:split_rd], radar_labels[:split_rd]\n\u001b[32m     65\u001b[39m x_va_rd, y_va_rd = norm_radar[split_rd:], radar_labels[split_rd:]\n",
